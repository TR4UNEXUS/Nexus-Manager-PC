<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0F1320" Foreground="#F3FBFF" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="BrandLogo" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="NEXUS" FontSize="24" FontWeight="Bold" Foreground="#92B5FF"/><TextBlock Text="USB FORMATTER" FontSize="11" Foreground="#B2C2DB"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="AccessState" Foreground="#B2C2DB" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Background="#182034" BorderBrush="#384961" BorderThickness="1" CornerRadius="12" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="10,5" FontSize="11"/><TextBlock Text="USB DRIVE" Foreground="#92B5FF" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
     <ComboBox x:Name="DriveList" Margin="0,10,0,12" MinHeight="40" ToolTip="A single eligible USB drive is selected automatically in Keep files mode. No operation starts automatically."/>
     <Grid x:Name="PartitionMap" Height="34" Background="#141B2C"/>
     <TextBlock x:Name="MapLegend" Text="Connect a USB drive." TextWrapping="Wrap" Foreground="#B2C2DB" FontSize="11" Margin="0,6,0,10"/>
     <TextBlock x:Name="DiskSafety" Text="No drive selected." TextWrapping="Wrap" Foreground="#B2C2DB" Margin="0,0,0,12"/>
     <Expander Header="Drive details" Foreground="#B2C2DB">
      <TextBlock x:Name="DiskDetails" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/>
     </Expander>
     <Expander x:Name="ReportExpander" Header="Inspection report" Foreground="#B2C2DB" Margin="0,8,0,0">
      <TextBox x:Name="InspectionReport" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Text="No report yet." Margin="0,8,0,0"/>
     </Expander>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.Column="2" Background="#182034" BorderBrush="#384961" BorderThickness="1" CornerRadius="12" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="OPERATION" Foreground="#92B5FF" FontWeight="SemiBold"/>
     <RadioButton x:Name="KeepFilesMode" Content="Keep files / convert" GroupName="Mode" IsChecked="True" Foreground="#F3FBFF" Margin="0,12,0,10"/>
     <RadioButton x:Name="EraseMode" Content="Erase / format" GroupName="Mode" Foreground="#FFB5AB" Margin="0,0,0,16"/>
     <StackPanel x:Name="ManagerPanel">
      <TextBlock Text="Partition" Foreground="#B2C2DB" FontSize="12"/>
      <ComboBox x:Name="PartitionList" MinHeight="38" Margin="0,6,0,10"/>
      <TextBlock x:Name="PartitionHint" Text="Select an exFAT partition." TextWrapping="Wrap" FontSize="12" Foreground="#B2C2DB" Margin="0,0,0,12"/>
      <TextBlock Text="Partition table" Foreground="#B2C2DB" FontSize="12"/>
      <ComboBox x:Name="ConversionTarget" SelectedIndex="0" Margin="0,6,0,12">
       <ComboBoxItem Content="Keep current"/><ComboBoxItem Content="MBR"/><ComboBoxItem Content="GPT"/>
      </ComboBox>
      <CheckBox x:Name="ConvertClusters" Content="Use 512 KB exFAT clusters" IsChecked="True" Foreground="#F3FBFF" Margin="0,0,0,12"/>
      <Button x:Name="InspectPartition" Content="Check drive" Padding="12,8" HorizontalAlignment="Left"/>
      <TextBlock Text="Conversion requires a separate backup and free PC space for recovery." TextWrapping="Wrap" Foreground="#FFD39A" FontSize="12" Margin="0,12,0,0"/>
     </StackPanel>
     <StackPanel x:Name="FormatPanel" Visibility="Collapsed">
      <UniformGrid Columns="2"><Button x:Name="StandardButton" Content="MBR" Margin="0,0,4,0" Padding="12,9"/><Button x:Name="LargeButton" Content="GPT" Margin="4,0,0,0" Padding="12,9"/></UniformGrid>
      <TextBlock x:Name="ProfileHeading" FontSize="12" Foreground="#92B5FF" Margin="0,12,0,6"/>
      <TextBlock x:Name="ProfileHint" FontSize="12" TextWrapping="Wrap" Foreground="#B2C2DB"/>
      <DockPanel Margin="0,14,0,0"><TextBlock x:Name="ProfileStyle" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="exFAT / 512 KB" Foreground="#B2C2DB"/></DockPanel>
      <TextBlock Text="Drive name" Foreground="#B2C2DB" FontSize="12" Margin="0,14,0,6"/>
      <TextBox x:Name="LabelBox" Text="NEXUS_USB" MaxLength="11"/>
      <TextBlock Text="Erases every partition and file on this drive." TextWrapping="Wrap" Foreground="#FFB5AB" Margin="0,14,0,0"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock x:Name="StageText" Text="Looking for USB drives..." TextTrimming="CharacterEllipsis" FontSize="12"/>
   <Expander x:Name="ActivityExpander" Header="Activity / technical details" Foreground="#B2C2DB" FontSize="11" Margin="0,6,0,0">
    <TextBox x:Name="ActivityLog" IsReadOnly="True" Height="95" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
   </Expander>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="NEXUS USB FORMATTER" Foreground="#B2C2DB" FontSize="10"/><TextBlock x:Name="ModeWarning" FontSize="11" TextWrapping="Wrap" Foreground="#B2C2DB" Margin="0,3,8,0"/><TextBlock x:Name="FooterText" Visibility="Collapsed"/></StackPanel>
   <Button x:Name="RecoverButton" Grid.Column="1" Content="Recover" Padding="12,9" IsEnabled="False" ToolTip="Restore an interrupted conversion from its PC journal. The drive must still be offline."/>
   <Button x:Name="LogsButton" Grid.Column="2" Content="Logs" Padding="12,9" Margin="8,0"/>
   <Button x:Name="FormatButton" Grid.Column="3" Content="Erase &amp; format" Background="#F08C7F" Foreground="#0F1320" Padding="16,10" Visibility="Collapsed" IsEnabled="False"/>
   <Button x:Name="ConvertButton" Grid.Column="3" Content="Convert" Background="#A695F8" Foreground="#0F1320" Padding="20,10" IsEnabled="False"/>
  </Grid>
 </Grid>
</UserControl>
