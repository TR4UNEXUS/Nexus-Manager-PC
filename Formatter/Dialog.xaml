<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="570" Height="585" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="#0F1320" Foreground="#F3FBFF" FontFamily="Segoe UI" FontSize="14"
 KeyboardNavigation.TabNavigation="Cycle">
 <Border Background="#0F1320" BorderBrush="#524A91" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="20,16,16,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid x:Name="DragArea" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image x:Name="DialogLogo" Width="34" Height="34" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="NEXUS" FontSize="17" FontWeight="Bold" Foreground="#92B5FF"/>
      <TextBlock Text="USB FORMATTER" FontSize="10" Foreground="#B2C2DB"/>
     </StackPanel>
    </Grid>
    <Button x:Name="DismissButton" Grid.Column="1" Content="&#x2715;" Width="32" Height="32" Padding="0" FontSize="14"
     Background="#182034" ToolTip="Close without continuing" AutomationProperties.Name="Close dialog" IsTabStop="False"/>
   </Grid>
   <Grid Grid.Row="1" Margin="24,20,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="StatusBadge" Background="#24314C" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" HorizontalAlignment="Left">
      <TextBlock x:Name="StatusSymbol" Text="!" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFD39A"/>
     </Border>
     <TextBlock x:Name="DialogHeading" Grid.Column="1" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </Grid>
    <Border Grid.Row="1" Background="#182034" BorderBrush="#384961" BorderThickness="1" CornerRadius="10" Padding="16">
     <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
      KeyboardNavigation.TabNavigation="Local">
      <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" Foreground="#F3FBFF" FontSize="14" LineHeight="21"/>
     </ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#384961" BorderThickness="0,1,0,0" Padding="24,14,24,18">
    <StackPanel>
     <TextBlock x:Name="DialogNote" Text="Nothing changes unless you choose to continue." Foreground="#FFD39A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelDialog" Content="Cancel" MinWidth="100" IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
      <Button x:Name="AcceptDialog" Content="Continue" MinWidth="112" Background="#A695F8" Foreground="#0F1320" IsDefault="False"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
